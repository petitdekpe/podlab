{% extends 'admin/layout.html.twig' %}
{% set active = 'codes' %}

{% block admin_title %}Billets{% endblock %}

{% block admin_content %}
    <h1 class="adm-h1">Billets validés <span class="adm-muted">({{ total }})</span></h1>
    <p class="adm-muted">Les billets Tick Africa apparaissent ici à leur première saisie sur la page du direct, une fois validés par Tick Africa (leur entrée y est alors enregistrée). Révoquer un billet ne bloque l'accès que sur ce site.</p>

    <section class="adm-card adm-toolbar">
        <form method="get" class="adm-search">
            <label class="adm-sr" for="q">Rechercher</label>
            <input id="q" name="q" type="search" class="adm-input" value="{{ q }}" placeholder="Rechercher un code ou un porteur">
            <label class="adm-sr" for="statut">Statut</label>
            <select id="statut" name="statut" class="adm-input">
                <option value="all"{{ status == 'all' ? ' selected' }}>Tous</option>
                <option value="used"{{ status == 'used' ? ' selected' }}>Actifs</option>
                <option value="revoked"{{ status == 'revoked' ? ' selected' }}>Révoqués</option>
            </select>
            <label class="adm-sr" for="direct">Direct</label>
            <select id="direct" name="direct" class="adm-input">
                <option value="">Tous les directs</option>
                {% for d in directs|reverse %}<option value="{{ d.id }}"{{ direct and direct.id == d.id ? ' selected' }}>{{ d.titre }} · {{ d.ouverture|date('d/m/Y', 'Africa/Porto-Novo') }}</option>{% endfor %}
            </select>
            <button type="submit" class="adm-btn">Filtrer</button>
        </form>

        <a class="adm-btn" href="{{ path('app_admin_codes_export', direct ? {direct: direct.id} : {}) }}">Exporter (CSV)</a>
    </section>

    <div class="adm-tablewrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Porteur · billet</th>
                    <th scope="col">Statut</th>
                    <th scope="col">1ʳᵉ connexion</th>
                    <th scope="col">Dernière activité</th>
                    <th scope="col"><span class="adm-sr">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for code in items %}
                    <tr class="{{ code.revoked ? 'is-revoked' }}">
                        <td data-label="Code"><code class="adm-code">{{ code.code }}</code>{% if not direct and directs|length > 1 and code.direct %}<br><span class="adm-muted">{{ code.direct.titre }} · {{ code.direct.ouverture|date('d/m', 'Africa/Porto-Novo') }}</span>{% endif %}</td>
                        <td data-label="Porteur · billet">
                            <form method="post" action="{{ path('app_admin_code_label', {id: code.id}) }}" class="adm-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <input type="hidden" name="back" value="{{ back }}">
                                <label class="adm-sr" for="label-{{ code.id }}">Libellé du billet {{ code.code }}</label>
                                <input id="label-{{ code.id }}" name="label" type="text" class="adm-input adm-input--inline" maxlength="160" value="{{ code.label }}" placeholder="Nom du porteur…">
                                <button type="submit" class="adm-btn adm-btn--small">OK</button>
                            </form>
                        </td>
                        <td data-label="Statut">
                            {% if code.revoked %}<span class="adm-tag adm-tag--bad">Révoqué</span>
                            {% elseif code.claimToken %}<span class="adm-tag adm-tag--ok">Connecté</span>
                            {% else %}<span class="adm-tag">Actif</span>{% endif %}
                        </td>
                        <td data-label="1ʳᵉ connexion">{{ code.firstUsedAt ? code.firstUsedAt|date('d/m H:i', 'Africa/Porto-Novo') : '—' }}</td>
                        <td data-label="Dernière activité">{{ code.lastSeenAt ? code.lastSeenAt|date('d/m H:i', 'Africa/Porto-Novo') : '—' }}</td>
                        <td data-label="Actions" class="adm-cell-actions">
                            {% if code.claimToken and not code.revoked %}
                                <form method="post" action="{{ path('app_admin_code_disconnect', {id: code.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                    <input type="hidden" name="back" value="{{ back }}">
                                    <button type="submit" class="adm-btn adm-btn--small">Déconnecter</button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('app_admin_code_revoke', {id: code.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <input type="hidden" name="back" value="{{ back }}">
                                <button type="submit" class="adm-btn adm-btn--small{{ code.revoked ? '' : ' adm-btn--danger' }}">{{ code.revoked ? 'Réactiver' : 'Révoquer' }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="adm-empty">Aucun billet ne correspond.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pages > 1 %}
        <nav class="adm-pager" aria-label="Pagination">
            {% if page > 1 %}<a class="adm-btn adm-btn--small" href="{{ path('app_admin_codes', {q: q, statut: status, direct: direct ? direct.id : null, page: page - 1}) }}">← Précédent</a>{% endif %}
            <span class="adm-muted">Page {{ page }} / {{ pages }}</span>
            {% if page < pages %}<a class="adm-btn adm-btn--small" href="{{ path('app_admin_codes', {q: q, statut: status, direct: direct ? direct.id : null, page: page + 1}) }}">Suivant →</a>{% endif %}
        </nav>
    {% endif %}
{% endblock %}
