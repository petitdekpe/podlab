{% extends 'base.html.twig' %}

{% block title %}Connexion · Administration{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block body %}
    <main class="adm-login">
        <section class="adm-card adm-login__card" aria-labelledby="adm-login-title">
            <img src="{{ asset('images/logo-podlab.jpg') }}" alt="Podlab" class="adm-login__logo">
            <h1 id="adm-login-title" class="adm-h1">Administration du direct</h1>

            {% if not configured %}
                <p class="adm-alert adm-alert--error" role="alert">Aucun supercode n'est défini. Lancez <code>php bin/console app:live:supercode</code> sur le serveur.</p>
            {% endif %}
            {% if error %}
                <p class="adm-alert adm-alert--error" role="alert">{{ error }}</p>
            {% endif %}

            <form method="post" class="adm-form">
                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                <label class="adm-label" for="supercode">Supercode</label>
                <input id="supercode" name="supercode" type="password" class="adm-input" autocomplete="off" autocapitalize="characters" spellcheck="false" required autofocus>
                <button type="submit" class="adm-btn adm-btn--primary adm-btn--block">Entrer</button>
            </form>
        </section>
    </main>
{% endblock %}
