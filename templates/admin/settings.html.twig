{% extends 'admin/layout.html.twig' %}
{% set active = 'settings' %}

{% block admin_title %}Paramètres{% endblock %}

{% block admin_content %}
    <h1 class="adm-h1">Paramètres</h1>

    {% for error in errors %}
        <p class="adm-alert adm-alert--error" role="alert">{{ error }}</p>
    {% endfor %}

    <form method="post" class="adm-card adm-form adm-form--wide">
        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">

        <h2 class="adm-h2">Connexion à Tick Africa</h2>

        <p class="adm-help">
            Clé utilisée&nbsp;:
            {% if tickafrica_key_source == 'admin' %}
                <code>{{ tickafrica_key_masked }}</code>, enregistrée ici{{ tickafrica_test ? ' (clé de test : aucun paiement réel, seuls les billets de test sont acceptés)' : ' (production)' }}.
            {% elseif tickafrica_key_source == 'env' %}
                <code>{{ tickafrica_key_masked }}</code>, celle du serveur (variable TICKAFRICA_API_KEY){{ tickafrica_test ? ', clé de test' : '' }}.
            {% else %}
                <strong>aucune</strong>. La billetterie et la vérification des billets du direct sont à l'arrêt.
            {% endif %}
        </p>
        {% if tickafrica_key_unreadable %}
            <p class="adm-alert adm-alert--error">La clé enregistrée ici ne peut plus être lue (APP_SECRET du serveur a changé). Saisissez-la à nouveau.</p>
        {% endif %}

        <label class="adm-label" for="tickafrica_api_key">{{ tickafrica_key_source == 'admin' ? 'Remplacer la clé API' : 'Clé API Tick Africa' }}</label>
        <input id="tickafrica_api_key" name="tickafrica_api_key" type="password" class="adm-input" value="" placeholder="ta_live_…" autocomplete="new-password" spellcheck="false"{{ can_store_secrets ? '' : ' disabled' }}>
        <p class="adm-help">
            Back-office Tick Africa, onglet « API &amp; intégrations ». Portées nécessaires&nbsp;: <code>events:read</code>, <code>orders:write</code>, <code>orders:read</code> et <code>tickets:validate</code>.
            La clé est vérifiée auprès de Tick Africa, puis enregistrée chiffrée&nbsp;; elle n'est plus jamais affichée. Laissez le champ vide pour garder la clé actuelle.
            {% if not can_store_secrets %}<br><strong>Indisponible&nbsp;:</strong> APP_SECRET n'est pas défini sur le serveur (fichier .env.local).{% endif %}
        </p>
        {% if tickafrica_key_source == 'admin' %}
            <label class="adm-check">
                <input type="checkbox" name="tickafrica_api_key_clear" value="1">
                <span><strong>Supprimer la clé enregistrée ici</strong><br><span class="adm-muted">Le site reprend alors la clé du serveur (TICKAFRICA_API_KEY), s'il y en a une.</span></span>
            </label>
        {% endif %}

        <label class="adm-label" for="return_url">URL de retour après paiement</label>
        <input id="return_url" name="return_url" type="url" class="adm-input" value="{{ form.return_url }}" placeholder="{{ return_url_default }}" autocomplete="off" spellcheck="false">
        <p class="adm-help">
            Page où Tick Africa renvoie l'acheteur après paiement. <strong>Elle doit être enregistrée sur la clé, à l'identique</strong>, dans le back-office Tick Africa («&nbsp;API &amp; intégrations&nbsp;»), sinon toute commande est refusée.
            Laissé vide, le site envoie <code>{{ form.return_url ?: return_url_default }}</code>&nbsp;: c'est cette adresse qu'il faut copier sur la clé.
        </p>

        <h2 class="adm-h2 adm-h2--section">Mesure d'audience et publicité</h2>

        <label class="adm-label" for="analytics_id">Google Analytics : identifiant de mesure</label>
        <input id="analytics_id" name="analytics_id" type="text" class="adm-input" maxlength="30" value="{{ form.analytics_id }}" placeholder="G-XXXXXXXXXX" autocomplete="off" spellcheck="false">
        <p class="adm-help">Dans Google Analytics&nbsp;: Administration, Flux de données, votre site. Mesure les pages publiques seulement, après accord du visiteur. Vide&nbsp;: pas de mesure.</p>

        <label class="adm-label" for="pixel_id">Pixel Meta (Facebook, Instagram) : identifiant</label>
        <input id="pixel_id" name="pixel_id" type="text" class="adm-input" maxlength="30" value="{{ form.pixel_id }}" placeholder="123456789012345" inputmode="numeric" autocomplete="off" spellcheck="false">
        <p class="adm-help">
            Dans le Gestionnaire d'évènements Meta&nbsp;: Sources de données, votre pixel, Paramètres. Les chiffres seulement, pas le code.
            Envoie, après accord du visiteur&nbsp;: page vue, séance choisie (ViewContent), paiement lancé (InitiateCheckout) et achat confirmé (Purchase). Aucune donnée personnelle. Vide&nbsp;: pas de pixel.
            <br>Sans Google Analytics ni pixel, le bandeau de cookies ne s'affiche pas.
        </p>

        <p class="adm-actions"><button type="submit" class="adm-btn adm-btn--primary">Enregistrer</button></p>
    </form>

    <section class="adm-card" id="affiche" data-controller="poster" data-poster-max-width-value="{{ constant('App\\Site\\Affiche::MAX_WIDTH') }}">
        <h2 class="adm-h2">Affiche de l'accueil</h2>
        {% for message in app.flashes('affiche_ok') %}<p class="adm-alert adm-alert--ok" role="status">{{ message }}</p>{% endfor %}
        {% for message in app.flashes('affiche_error') %}<p class="adm-alert adm-alert--error" role="alert">{{ message }}</p>{% endfor %}

        <div class="adm-poster">
            <img src="{{ affiche ? path('app_affiche', { v: affiche.version }) : asset(constant('App\\Site\\Affiche::ORIGINE')) }}" alt="Affiche" class="adm-poster__img" data-poster-target="preview">
            <div class="adm-poster__body">
                <form method="post" action="{{ path('app_admin_affiche') }}" enctype="multipart/form-data" class="adm-form" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                    <label class="adm-label" for="affiche-fichier">Nouvelle affiche</label>
                    <input id="affiche-fichier" name="affiche" type="file" accept="image/jpeg,image/png,image/webp" required data-poster-target="input" data-action="poster#pick">
                    <p class="adm-help" role="status" data-poster-target="status">JPEG, PNG ou WebP, en portrait (idéalement 4:5). L'image est réduite automatiquement.</p>
                    <p class="adm-actions"><button type="submit" class="adm-btn adm-btn--primary" data-poster-target="submit">Remplacer l'affiche</button></p>
                </form>
                {% if affiche %}
                    <form method="post" action="{{ path('app_admin_affiche') }}" data-turbo="false" onsubmit="return confirm('Revenir à l\'affiche d\'origine ? L\'image envoyée sera supprimée.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <input type="hidden" name="retablir" value="1">
                        <button type="submit" class="adm-btn adm-btn--small">Revenir à l'affiche d'origine</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="adm-card" id="tickafrica-diagnostic">
        <h2 class="adm-h2">Diagnostic Tick Africa</h2>

        {% if derniere_erreur %}
            <div class="adm-alert adm-alert--error" role="status">
                <strong>Dernière commande échouée</strong> · {{ derniere_erreur.when }} · séance {{ derniere_erreur.seance }}<br>
                Réponse&nbsp;: <code>{{ derniere_erreur.status ?: 'pas de réponse' }} {{ derniere_erreur.error }}</code>
                {% if derniere_erreur.message %}· «&nbsp;{{ derniere_erreur.message }}&nbsp;»{% endif %}
                {% if derniere_erreur.fields %}<br>Champs en cause&nbsp;: <code>{{ derniere_erreur.fields|join(', ') }}</code>{% endif %}
                {% if derniere_erreur.return_url ?? false %}<br>URL de retour envoyée&nbsp;: <code>{{ derniere_erreur.return_url }}</code>{% endif %}
                <br><strong>Que faire&nbsp;:</strong> {{ derniere_erreur.explication }}
            </div>
        {% else %}
            <p class="adm-muted">Aucune commande échouée récemment.</p>
        {% endif %}

        <p class="adm-muted">Vérifie chaque autorisation de la clé auprès de Tick Africa. Rien n'est acheté, créé ni consommé.</p>
        <form method="post" action="{{ path('app_admin_tickafrica_check') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
            <button type="submit" class="adm-btn adm-btn--primary">Vérifier les autorisations de la clé</button>
        </form>

        {% if diagnostic %}
            <div class="adm-tablewrap adm-diag">
                <table class="adm-table">
                    <thead><tr><th>Autorisation</th><th>Sert à</th><th>Résultat</th></tr></thead>
                    <tbody>
                        {% set usages = {
                            'events:read': 'Afficher les séances, prix et places',
                            'orders:write': 'Vendre (créer la commande et le lien de paiement)',
                            'orders:read': 'Afficher l\'état du paiement au retour',
                            'tickets:validate': 'Vérifier les codes du direct',
                        } %}
                        {% for scope, r in diagnostic.results %}
                            <tr>
                                <td><code>{{ scope }}</code></td>
                                <td>{{ usages[scope] ?? '' }}</td>
                                <td>{{ r.ok is same as(true) ? '✅' : (r.ok is same as(false) ? '❌' : '⚠️') }} {{ r.detail }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="adm-help">Vérifié le {{ diagnostic.at }} avec la clé <code>{{ diagnostic.key }}</code>.</p>
        {% endif %}
    </section>

    <section class="adm-card">
        <h2 class="adm-h2">Supercode</h2>
        <p class="adm-muted">Le supercode ouvre cet espace d'administration et donne accès au direct à tout moment, sur autant d'appareils que nécessaire. Il ne s'affiche qu'une fois : en créer un nouveau désactive immédiatement l'ancien.</p>

        {% for code in app.flashes('admin_supercode') %}
            <p class="adm-alert adm-alert--ok" role="status">Nouveau supercode (à noter maintenant, il ne sera plus affiché) :<br><code class="adm-secret">{{ code }}</code></p>
        {% endfor %}

        <form method="post" action="{{ path('app_admin_supercode') }}" onsubmit="return confirm('Créer un nouveau supercode ? L\'ancien cessera de fonctionner immédiatement.');">
            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
            <button type="submit" class="adm-btn adm-btn--danger">Créer un nouveau supercode</button>
        </form>
    </section>
{% endblock %}
