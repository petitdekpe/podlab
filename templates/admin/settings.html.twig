{% extends 'admin/layout.html.twig' %}
{% set active = 'settings' %}

{% block admin_title %}Paramètres{% endblock %}

{% block admin_content %}
    <h1 class="adm-h1">Paramètres du direct</h1>

    {% for error in errors %}
        <p class="adm-alert adm-alert--error" role="alert">{{ error }}</p>
    {% endfor %}

    <form method="post" class="adm-card adm-form adm-form--wide">
        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">

        <label class="adm-label" for="title">Titre affiché sur la page du direct</label>
        <input id="title" name="title" type="text" class="adm-input" maxlength="120" value="{{ form.title }}">

        <label class="adm-label" for="youtube">Vidéo YouTube du direct</label>
        <input id="youtube" name="youtube" type="text" class="adm-input" value="{{ form.youtube }}" placeholder="https://www.youtube.com/watch?v=… ou identifiant" autocomplete="off" spellcheck="false">
        <p class="adm-help">Vidéo « non répertoriée », intégration autorisée, <strong>option DVR désactivée</strong> dans YouTube Studio (sinon les spectateurs peuvent reculer). Jamais visible dans le code de la page : elle n'est fournie qu'aux billets valides.</p>

        <div class="adm-row">
            <div>
                <label class="adm-label" for="opens_at">Ouverture du direct</label>
                <input id="opens_at" name="opens_at" type="datetime-local" class="adm-input" value="{{ form.opens_at }}" required>
            </div>
            <div>
                <label class="adm-label" for="ends_at">Fin du direct</label>
                <input id="ends_at" name="ends_at" type="datetime-local" class="adm-input" value="{{ form.ends_at }}" required>
            </div>
        </div>
        <p class="adm-help">Heure du Bénin ({{ timezone }}). Avant l'ouverture, les spectateurs voient un décompte. Après la fin, la vidéo est retirée.</p>

        <label class="adm-check">
            <input type="checkbox" name="enabled" value="1"{{ form.enabled ? ' checked' }}>
            <span><strong>Accès ouvert</strong><br><span class="adm-muted">Décochez pour fermer l'accès à tous les billets d'un coup (le supercode reste valable).</span></span>
        </label>

        <label class="adm-check">
            <input type="checkbox" name="watermark" value="1"{{ form.watermark ? ' checked' }}>
            <span><strong>Filigrane avec le numéro du billet</strong><br><span class="adm-muted">Un texte discret se déplace sur la vidéo : il permet de retrouver l'origine d'un enregistrement partagé.</span></span>
        </label>

        {# Identifiants proposés à la saisie : les événements publiés de la clé #}
        <datalist id="tickafrica-events">
            {% for event in tickafrica_events %}<option value="{{ event.id }}">{{ event.label }}</option>{% endfor %}
        </datalist>

        <h2 class="adm-h2 adm-h2--section">Connexion à Tick Africa</h2>

        <p class="adm-help">
            Clé utilisée&nbsp;:
            {% if tickafrica_key_source == 'admin' %}
                <code>{{ tickafrica_key_masked }}</code>, enregistrée ici{{ tickafrica_test ? ' (clé de test : aucun paiement réel, seuls les billets de test sont acceptés)' : ' (production)' }}.
            {% elseif tickafrica_key_source == 'env' %}
                <code>{{ tickafrica_key_masked }}</code>, celle du serveur (variable TICKAFRICA_API_KEY){{ tickafrica_test ? ', clé de test' : '' }}.
            {% else %}
                <strong>aucune</strong>. La billetterie et la vérification des billets du direct sont à l'arrêt.
            {% endif %}
        </p>
        {% if tickafrica_key_unreadable %}
            <p class="adm-alert adm-alert--error">La clé enregistrée ici ne peut plus être lue (APP_SECRET du serveur a changé). Saisissez-la à nouveau.</p>
        {% endif %}

        <label class="adm-label" for="tickafrica_api_key">{{ tickafrica_key_source == 'admin' ? 'Remplacer la clé API' : 'Clé API Tick Africa' }}</label>
        <input id="tickafrica_api_key" name="tickafrica_api_key" type="password" class="adm-input" value="" placeholder="ta_live_…" autocomplete="new-password" spellcheck="false"{{ can_store_secrets ? '' : ' disabled' }}>
        <p class="adm-help">
            Back-office Tick Africa, onglet « API &amp; intégrations ». Portées nécessaires&nbsp;: <code>events:read</code>, <code>orders:write</code>, <code>orders:read</code> et <code>tickets:validate</code>.
            La clé est vérifiée auprès de Tick Africa, puis enregistrée chiffrée&nbsp;; elle n'est plus jamais affichée. Laissez le champ vide pour garder la clé actuelle.
            {% if not can_store_secrets %}<br><strong>Indisponible&nbsp;:</strong> APP_SECRET n'est pas défini sur le serveur (fichier .env.local).{% endif %}
        </p>
        {% if tickafrica_key_source == 'admin' %}
            <label class="adm-check">
                <input type="checkbox" name="tickafrica_api_key_clear" value="1">
                <span><strong>Supprimer la clé enregistrée ici</strong><br><span class="adm-muted">Le site reprend alors la clé du serveur (TICKAFRICA_API_KEY), s'il y en a une.</span></span>
            </label>
        {% endif %}

        <label class="adm-label" for="return_url">URL de retour après paiement</label>
        <input id="return_url" name="return_url" type="url" class="adm-input" value="{{ form.return_url }}" placeholder="{{ return_url_default }}" autocomplete="off" spellcheck="false">
        <p class="adm-help">
            Page où Tick Africa renvoie l'acheteur après paiement. <strong>Elle doit être enregistrée sur la clé, à l'identique</strong>, dans le back-office Tick Africa («&nbsp;API &amp; intégrations&nbsp;»), sinon toute commande est refusée.
            Laissé vide, le site envoie <code>{{ form.return_url ?: return_url_default }}</code>&nbsp;: c'est cette adresse qu'il faut copier sur la clé.
        </p>

        <h2 class="adm-h2 adm-h2--section">Billets du direct</h2>

        <label class="adm-label" for="tickafrica_event_id">Identifiant de l'événement « accès au direct »</label>
        <input id="tickafrica_event_id" name="tickafrica_event_id" type="text" class="adm-input" list="tickafrica-events" value="{{ form.tickafrica_event_id }}" placeholder="{{ tickafrica_event_default ?: '9a8b7c6d-5e4f-3a2b-1c0d-9e8f7a6b5c4d' }}" autocomplete="off" spellcheck="false">
        <p class="adm-help">
            UUID de l'événement Tick Africa dont les billets ouvrent le direct. Les billets d'un autre événement (la salle, par exemple) sont refusés et ne sont pas consommés.
            {% if tickafrica_events %}Cliquez dans le champ pour choisir parmi vos événements.{% endif %}
            {% if tickafrica_event_default %}Laissé vide, c'est la valeur par défaut du site qui est utilisée : <code>{{ tickafrica_event_default }}</code>{% else %}Tant qu'il est vide, aucun nouveau billet n'est accepté.{% endif %}
        </p>

        <h2 class="adm-h2 adm-h2--section">Billetterie des séances</h2>
        <p class="adm-help">
            Reliez chaque séance à son événement Tick Africa{% if tickafrica_events %} (cliquez dans le champ pour choisir parmi vos événements){% endif %}.
            Si deux séances partagent un même événement, indiquez pour chacune l'identifiant de son billet (plusieurs : séparés par des virgules).
            Les identifiants des billets s'affichent avec <code>php bin/console app:tickafrica:event &lt;uuid&gt;</code>.
        </p>

        {% for key, seance in form.seances %}
            {% set etat = seances_etat[key] ?? null %}
            <fieldset class="adm-seance">
                <legend class="adm-seance__title">
                    {{ seance.label }}
                    {% if etat %}
                        <span class="adm-seance__state adm-seance__state--{{ etat.status }}">
                            {{ {en_vente: 'En vente', complet: 'Complet', passee: 'Terminée', fermee: 'Vente fermée', indisponible: 'Non reliée ou injoignable'}[etat.status] }}
                        </span>
                    {% endif %}
                </legend>
                <div class="adm-row">
                    <div>
                        <label class="adm-label" for="seance-{{ key }}-event">Événement Tick Africa</label>
                        <input id="seance-{{ key }}-event" name="seances[{{ key }}][event]" type="text" class="adm-input" list="tickafrica-events" value="{{ seance.event }}" placeholder="{{ seance.default ?: 'UUID de l\'événement' }}" autocomplete="off" spellcheck="false">
                    </div>
                    <div>
                        <label class="adm-label" for="seance-{{ key }}-tarifs">Billets à vendre (facultatif)</label>
                        <input id="seance-{{ key }}-tarifs" name="seances[{{ key }}][tarifs]" type="text" class="adm-input" value="{{ seance.tarifs }}" placeholder="Tous les billets de l'événement" autocomplete="off" spellcheck="false">
                    </div>
                </div>
                {% if etat and (etat.eventName or etat.reason) %}
                    <p class="adm-help">
                        {% if etat.eventName %}Événement trouvé chez Tick Africa&nbsp;: <strong>{{ etat.eventName }}</strong>.{% endif %}
                        {% if etat.reason and etat.reason != 'complet_force' %}
                            {% if etat.status != 'en_vente' %}<strong>Pourquoi&nbsp;?</strong>{% endif %}
                            {{ constant('App\\Billetterie\\Seance::REASONS')[etat.reason] ?? etat.reason }}
                        {% endif %}
                    </p>
                {% endif %}
                {% if etat and etat.tarifs|length > 0 %}
                    <p class="adm-help">
                        {% for t in etat.tarifs %}
                            {{ t.name }} · {{ t.price|number_format(0, ',', ' ') }} FCFA · {{ t.remaining is null ? 'illimité' : t.remaining ~ ' restante(s)' }} · <code>{{ t.id }}</code>{% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                    </p>
                {% elseif not seance.event and seance.default %}
                    <p class="adm-help">Vide&nbsp;: valeur du serveur utilisée (<code>{{ seance.default }}</code>).</p>
                {% endif %}
            </fieldset>
        {% endfor %}

        <label class="adm-check">
            <input type="checkbox" name="soldout" value="1"{{ form.soldout ? ' checked' }}>
            <span><strong>Séance du 22 novembre « Sold out »</strong><br><span class="adm-muted">Affiche la séance du 22 au Majestic Marina comme complète, avec le bouton d'achat d'un accès au direct. Les séances du 29 suivent la disponibilité en temps réel de Tick Africa. Décochez pour remettre la séance du 22 en vente (son événement doit alors être renseigné ci-dessus).</span></span>
        </label>

        <label class="adm-label" for="live_ticket_url">Billetterie des accès au direct (Tickafrica)</label>
        <input id="live_ticket_url" name="live_ticket_url" type="url" class="adm-input" value="{{ form.live_ticket_url }}" placeholder="{{ live_ticket_default ?: 'https://tick.africa/embed/…' }}" autocomplete="off" spellcheck="false">
        <p class="adm-help">
            Lien d'intégration (embed) Tickafrica de l'événement « accès au direct », affiché dans la fenêtre pop-up.
            {% if live_ticket_default %}Laissé vide, c'est le lien par défaut du site qui est utilisé : <code>{{ live_ticket_default }}</code>{% else %}Tant qu'il est vide, la fenêtre indique que la billetterie ouvre bientôt.{% endif %}
        </p>

        <p class="adm-actions"><button type="submit" class="adm-btn adm-btn--primary">Enregistrer</button></p>
    </form>

    <section class="adm-card" id="tickafrica-diagnostic">
        <h2 class="adm-h2">Diagnostic Tick Africa</h2>

        {% if derniere_erreur %}
            <div class="adm-alert adm-alert--error" role="status">
                <strong>Dernière commande échouée</strong> · {{ derniere_erreur.when }} · séance {{ derniere_erreur.seance }}<br>
                Réponse&nbsp;: <code>{{ derniere_erreur.status ?: 'pas de réponse' }} {{ derniere_erreur.error }}</code>
                {% if derniere_erreur.message %}· «&nbsp;{{ derniere_erreur.message }}&nbsp;»{% endif %}
                {% if derniere_erreur.fields %}<br>Champs en cause&nbsp;: <code>{{ derniere_erreur.fields|join(', ') }}</code>{% endif %}
                {% if derniere_erreur.return_url ?? false %}<br>URL de retour envoyée&nbsp;: <code>{{ derniere_erreur.return_url }}</code>{% endif %}
                <br><strong>Que faire&nbsp;:</strong> {{ derniere_erreur.explication }}
            </div>
        {% else %}
            <p class="adm-muted">Aucune commande échouée récemment.</p>
        {% endif %}

        <p class="adm-muted">Vérifie chaque autorisation de la clé auprès de Tick Africa. Rien n'est acheté, créé ni consommé.</p>
        <form method="post" action="{{ path('app_admin_tickafrica_check') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
            <button type="submit" class="adm-btn adm-btn--primary">Vérifier les autorisations de la clé</button>
        </form>

        {% if diagnostic %}
            <div class="adm-tablewrap adm-diag">
                <table class="adm-table">
                    <thead><tr><th>Autorisation</th><th>Sert à</th><th>Résultat</th></tr></thead>
                    <tbody>
                        {% set usages = {
                            'events:read': 'Afficher les séances, prix et places',
                            'orders:write': 'Vendre (créer la commande et le lien de paiement)',
                            'orders:read': 'Afficher l\'état du paiement au retour',
                            'tickets:validate': 'Vérifier les codes du direct',
                        } %}
                        {% for scope, r in diagnostic.results %}
                            <tr>
                                <td><code>{{ scope }}</code></td>
                                <td>{{ usages[scope] ?? '' }}</td>
                                <td>{{ r.ok is same as(true) ? '✅' : (r.ok is same as(false) ? '❌' : '⚠️') }} {{ r.detail }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="adm-help">Vérifié le {{ diagnostic.at }} avec la clé <code>{{ diagnostic.key }}</code>.</p>
        {% endif %}
    </section>

    <section class="adm-card">
        <h2 class="adm-h2">Supercode</h2>
        <p class="adm-muted">Le supercode ouvre cet espace d'administration et donne accès au direct à tout moment, sur autant d'appareils que nécessaire. Il ne s'affiche qu'une fois : en créer un nouveau désactive immédiatement l'ancien.</p>

        {% for code in app.flashes('admin_supercode') %}
            <p class="adm-alert adm-alert--ok" role="status">Nouveau supercode (à noter maintenant, il ne sera plus affiché) :<br><code class="adm-secret">{{ code }}</code></p>
        {% endfor %}

        <form method="post" action="{{ path('app_admin_supercode') }}" onsubmit="return confirm('Créer un nouveau supercode ? L\'ancien cessera de fonctionner immédiatement.');">
            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
            <button type="submit" class="adm-btn adm-btn--danger">Créer un nouveau supercode</button>
        </form>
    </section>
{% endblock %}
