{# État d'une séance, en une pastille. Variable : s (App\Billetterie\Seance) #}
{% set restantes = s.placesRestantes %}
{% if s.onSale %}
    {% if restantes is not null and restantes <= 30 %}
        <p class="status status--hot">Plus que {{ restantes }} place{{ restantes > 1 ? 's' }}</p>
    {% else %}
        <p class="status status--open">Places disponibles</p>
    {% endif %}
{% elseif s.soldOut %}
    <p class="status status--soldout">Sold out{% if s.liveAccess %} · direct en ligne{% endif %}</p>
{% elseif s.status == 'passee' %}
    <p class="status">Terminée</p>
{% elseif s.status == 'fermee' %}
    <p class="status">Vente fermée</p>
{% else %}
    <p class="status">Bientôt en vente</p>
{% endif %}
