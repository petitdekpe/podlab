{% extends 'base.html.twig' %}

{% block title %}Avant-Première Podlab - Majestic Marina{% endblock %}

{% block meta %}
    {% set apercu_titre = 'Avant-Première Podlab' %}
    {% set apercu_description = "Edgar-Yves : Moi, à quatre pattes ?! Ceci n'est pas un podcast, ceci n'est pas un stand-up, c'est un sit-down. Dimanche 22 novembre 2026, 13h00, Majestic Cinéma, Sofitel Marina, Cotonou." %}
    <meta name="description" content="{{ apercu_description }}">

    {# Aperçu du lien (WhatsApp, Facebook, LinkedIn, X…) #}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Podlab × Bénin Bouge">
    <meta property="og:title" content="{{ apercu_titre }}">
    <meta property="og:description" content="{{ apercu_description }}">
    <meta property="og:url" content="{{ absolute_url(path('app_home')) }}">
    <meta property="og:image" content="{{ absolute_url(asset('images/og-avant-premiere.png')) }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Podlab × Bénin Bouge">
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% set prix = prix_billet|number_format(0, ',', ' ') %}
{% set debut_iso = debut_projection|date('c') %}

{% set programme = [
    { heure: '12h30', titre: 'Accueil et installation' },
    { heure: '12h55', titre: 'Fermeture des portes', desc: 'Aucune entrée après, même avec un billet.' },
    { heure: '13h00 – 15h00', titre: 'Moi, à quatre pattes ?!', desc: "L'Édition Spéciale Podlab × Bénin Bouge sur grand écran.", highlight: true },
] %}

{% set pour_qui = [
    'Vous voulez passer un dimanche inoubliable, entre amis, en famille ou en couple.',
    "Vous avez envie d'un vrai moment de fou rire.",
    "Vous êtes fan des émissions Podlab ou des spectacles d'Edgar-Yves.",
    "Vous voulez vivre une expérience au-dessus de tout ce que vous avez déjà vécu en podcast.",
] %}

{% set a_entendre = [
    "Pourquoi, pour des parents béninois, « humoriste » n'est pas un métier… et comment son père a changé d'avis le jour où ça a marché.",
    "Le jour où sa maman a décidé de le « protéger ». Il n'était pas prêt.",
    "Pourquoi au Bénin, quelqu'un que vous avez croisé deux fois vous connaît déjà.",
    "Ce que 20 ans en France ne vous apprennent pas sur votre propre pays.",
] %}

{% block body %}
    {% if redirection_direct %}
        <div hidden data-controller="reload-at" data-reload-at-at-value="{{ redirection_direct|date('c') }}" data-reload-at-url-value="{{ path('app_live') }}"></div>
    {% endif %}
    {# ---------- En-tête ---------- #}
    <header class="container site-header">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Podlab × Bénin Bouge">
            <img src="{{ asset('images/logo-podlab.jpg') }}" alt="Podlab" class="brand__podlab">
            <span class="brand__times" aria-hidden="true">×</span>
            <img src="{{ asset('images/logo-benin-bouge.png') }}" alt="Bénin Bouge" class="brand__bb">
        </a>
        <nav class="site-nav" aria-label="Navigation principale">
            <a href="#invite" class="site-nav__link">L'invité</a>
            <a href="#programme" class="site-nav__link">Programme</a>
            <a href="#lieu" class="site-nav__link">Le lieu</a>
            <a href="#tarifs" class="site-nav__link">Billet</a>
            <a href="#reservation" class="btn btn--primary btn--sm">Réserver</a>
        </nav>
    </header>

    <main>
        {# ---------- Hero ---------- #}
        <section class="container hero">
            <p class="hero__kicker">Édition spéciale Podlab × Bénin Bouge</p>
            <h1 class="hero__title"><span class="hero__line">Edgar-Yves&nbsp;:</span> <span class="hero__line">Moi, à quatre pattes&nbsp;?!</span></h1>
            <p class="hero__tagline">Ceci n'est pas un podcast. Ceci n'est pas un <span class="nowrap">stand-up</span>. Ceci est un <span class="nowrap">sit-down</span>.</p>
            <p class="hero__intro">Edgar-Yves vit à l'étranger depuis 20 ans et revient au Bénin de temps à autre. Cette année, lors de son séjour, le pays ne l'a pas raté. Pendant deux heures, il raconte avec Beni Tossou des histoires vécues cette année, qu'il n'a jamais racontées nulle part. Enregistré dans les studios Podlab, projeté sur grand écran en partenariat avec Bénin Bouge.</p>

            <div class="facts">
                <div class="fact card">
                    <p class="label">Date</p>
                    <p class="fact__value">Dimanche 22 novembre 2026</p>
                </div>
                <div class="fact card">
                    <p class="label">Heure</p>
                    <p class="fact__value">13h00<br><span class="fact__note">Ouverture des portes à 12h30</span></p>
                </div>
                <div class="fact card">
                    <p class="label">Lieu</p>
                    <p class="fact__value">Majestic Cinéma,&nbsp;<br>Sofitel Marina, Cotonou</p>
                </div>
            </div>

            {# Trailer : se lance au clic (aucun démarrage automatique). Si on dépasse la vidéo en cours de lecture,
               le lecteur passe en miniature dans le coin de l'écran #}
            <div class="trailer" data-controller="trailer">
                <div class="trailer__player" data-trailer-target="player">
                    <video
                        class="trailer__video"
                        data-trailer-target="video"
                        data-action="click->trailer#toggleFromMini"
                        src="{{ asset('videos/trailer.mp4') }}"
                        poster="{{ asset('images/trailer-poster.jpg') }}"
                        controls
                        playsinline
                        preload="metadata"
                        aria-label="Bande-annonce : Edgar-Yves, Moi, à quatre pattes ?!"
                    ></video>
                    <button type="button" class="trailer__mini-btn trailer__expand" data-action="trailer#expand" aria-label="Revenir à la vidéo" title="Revenir à la vidéo">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                    <button type="button" class="trailer__mini-btn trailer__close" data-action="trailer#close" aria-label="Fermer la miniature" title="Fermer">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </div>
                <p class="trailer__placeholder" aria-hidden="true">La bande-annonce continue dans le coin de l'écran</p>
            </div>

            {# Décompte #}
            <div class="countdown" data-controller="countdown" data-countdown-target-value="{{ debut_iso }}">
                <div data-countdown-target="running" {{ decompte.ended ? 'hidden' }}>
                    <p class="countdown__heading">Début de la projection dans</p>
                    <div class="countdown__grid" role="timer" aria-live="off">
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="days">{{ decompte.d }}</p>
                            <p class="label">Jours</p>
                        </div>
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="hours">{{ decompte.h }}</p>
                            <p class="label">Heures</p>
                        </div>
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="minutes">{{ decompte.m }}</p>
                            <p class="label">Minutes</p>
                        </div>
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="seconds">{{ decompte.s }}</p>
                            <p class="label">Secondes</p>
                        </div>
                    </div>
                </div>
                <div data-countdown-target="ended" {{ decompte.ended ? '' : 'hidden' }}>
                    <p class="countdown__ended-title">La projection a commencé.</p>
                    <p class="countdown__ended-text">Merci d'avoir été là. Suivez Podlab pour la prochaine séance.</p>
                </div>
            </div>

            <div class="hero__cta">
                {% if soldout %}
                    <button type="button" class="btn btn--primary btn--lg" data-open-modal="live-tickets">
                        Sold out · Suivre le direct en ligne
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                    <span class="hero__cta-note">Toutes les places en salle sont vendues.</span>
                {% else %}
                    <a href="#reservation" class="btn btn--primary btn--lg">
                        Je réserve ma place — {{ prix }}&nbsp;FCFA
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                    <span class="hero__cta-note">Places limitées.</span>
                {% endif %}
            </div>
        </section>

        {# ---------- Affiche de l'événement ---------- #}
        <section class="container">
            <div class="poster">
                <img src="{{ asset('images/affiche-moi-a-quatre-pattes.jpg') }}" alt="Affiche : Podlab en collaboration avec Bénin Bouge présentent « Moi, à quatre pattes ? » avec Edgar-Yves Jr, dimanche 22 novembre 2026 de 13h à 15h au Majestic Cinéma, Sofitel Cotonou Marina. Réservation sur podlab.beninbouge.com" class="media-cover">
            </div>
        </section>

        {# ---------- Le concept ---------- #}
        <section class="container section split concept">
            <div>
                <p class="eyebrow">Le concept</p>
                <h2 class="h2">Un spectacle avant l'heure</h2>
            </div>
            <div class="lead concept__body">
                <p>Podlab, ce sont des conversations avec ceux qui font l'Afrique. Cette fois, avec Bénin Bouge, on a voulu aller plus loin.</p>
                <p>Edgar-Yves n'est pas venu faire un podcast. Il est venu raconter, avec l'humour qu'on lui connaît, ce qu'il a vécu cette année au Bénin&nbsp;: la famille, les parents, les croyances, les codes qu'il croyait connaître et qui l'ont pris de court.</p>
                <p>Résultat&nbsp;: deux heures qui ressemblent plus à un spectacle qu'à une interview. Alors on a décidé de vous le faire vivre comme un spectacle&nbsp;: en salle, sur grand écran, avec le son du cinéma et le rire de toute une salle.</p>
                <ul class="bullets">
                    <li><strong>Inédit.</strong> Des histoires vécues cette année, racontées ici pour la première fois. Ni en podcast, ni sur scène, ni sur les réseaux.</li>
                    <li><strong>En avant-première.</strong> Vous le découvrez avant tout le monde.</li>
                    <li><strong>Une expérience de salle.</strong> Grand écran, son cinéma, et le plaisir de rire ensemble.</li>
                </ul>
                <p class="concept__closing">Vous croyez connaître Edgar-Yves&nbsp;? Vous n'avez pas encore entendu celle-là.</p>
            </div>
        </section>

        {# ---------- Focus invité ---------- #}
        <section id="invite" class="container section">
            <div class="split guest card">
                <div class="guest__media">
                    <img src="{{ asset('images/edgar-yves.jpg') }}" alt="L'humoriste Edgar-Yves, éclat de rire, en noir et blanc" class="media-cover">
                    <p class="pill pill--accent">Invité d'honneur</p>
                </div>
                <div class="guest__body">
                    <p class="eyebrow">L'invité</p>
                    <h2 class="h2">Edgar-Yves comme vous ne l'avez jamais entendu</h2>
                    <p class="lead">Né au Bénin en 1987, Edgar-Yves a lâché le droit pour l'humour. Formé dans les comedy clubs de Nantes, passé par le Jamel Comedy Club et La Cigale, il tourne aujourd'hui jusqu'à l'Adidas Arena. Son terrain de jeu&nbsp;: l'autodérision et le choc entre l'Afrique et l'Europe.</p>
                    <blockquote class="guest__quote">« Si la presse est le quatrième pouvoir, l'humour doit être le cinquième. »</blockquote>
                    <div>
                        <p class="guest__listen-title">Ce que vous allez entendre</p>
                        <ul class="bullets">
                            {% for item in a_entendre %}
                                <li>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    <p class="guest__more">Et la réponse à la question que tout le monde va se poser&nbsp;: pourquoi «&nbsp;à quatre pattes&nbsp;»&nbsp;?</p>
                    <div>
                        <a href="#reservation" class="btn btn--primary">Je veux voir Edgar-Yves</a>
                    </div>
                </div>
            </div>
        </section>

        {# ---------- Pour qui ---------- #}
        <section class="container section">
            <p class="eyebrow">Pour qui ?</p>
            <h2 class="h2 u-mb-40">Vous allez adorer si…</h2>
            <div class="audience">
                {% for texte in pour_qui %}
                    <div class="audience__item card">
                        <p class="audience__num">{{ '%02d'|format(loop.index) }}</p>
                        <p>{{ texte }}</p>
                    </div>
                {% endfor %}
            </div>
            <div class="u-mt-32 audience__cta">
                <a href="#reservation" class="btn btn--outline">Je veux en être</a>
            </div>
        </section>

        {# ---------- Programme ---------- #}
        <section id="programme" class="container section">
            <p class="eyebrow">Programme</p>
            <h2 class="h2 u-mb-40">Le déroulé de l'après-midi</h2>
            <div class="schedule">
                {% for etape in programme %}
                    <div class="schedule__row{{ etape.highlight|default(false) ? ' schedule__row--highlight' }}">
                        <p class="schedule__time">{{ etape.heure }}</p>
                        <div>
                            <p class="schedule__title">{{ etape.titre }}</p>
                            {% if etape.desc is defined %}<p class="schedule__desc">{{ etape.desc }}</p>{% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# ---------- Lieu ---------- #}
        <section id="lieu" class="container section">
            <div class="split venue">
                <div class="venue__info">
                    <p class="eyebrow">Le lieu</p>
                    <h2 class="venue__name">Majestic Cinéma</h2>
                    <p class="venue__sub">Sofitel Marina Hotel</p>
                    <p class="venue__address">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                        Boulevard de la Marina, Cotonou
                    </p>
                    <p class="venue__lead">Fauteuils de cinéma, grand écran, son de salle&nbsp;: le cadre d'une vraie première.</p>
                    <a href="https://www.google.com/maps/search/?api=1&amp;query={{ 'Sofitel Cotonou Marina Hotel, Boulevard de la Marina, Cotonou'|url_encode }}" target="_blank" rel="noopener" class="btn btn--dark btn--md">Ouvrir dans Google Maps</a>
                </div>
                <div class="venue__media">
                    <img src="{{ asset('images/salle-majestic-marina.webp') }}" alt="Fauteuils en velours rouge avec tablettes, salle du Majestic Marina" class="media-cover" loading="lazy">
                </div>
            </div>
        </section>

        {# ---------- Billet ---------- #}
        <section id="tarifs" class="container section">
            <div class="split tickets">
                <div>
                    <p class="eyebrow">Billet</p>
                    <h2 class="h2 u-mb-16">Votre place pour l'Édition Spéciale</h2>
                    <p class="lead">Seulement 75 places. Une fois la salle pleine, les réservations ferment.</p>
                </div>
                <div class="ticket">
                    <div class="ticket__head">
                        <p class="ticket__kind">Billet unique{% if soldout %} <span class="soldout-tag">Sold out</span>{% endif %}</p>
                        <p class="ticket__date">Dim. 22 nov. · 13h00</p>
                    </div>
                    <p class="ticket__price">{{ prix }} <span class="ticket__currency">FCFA</span></p>
                    <div class="ticket__divider"></div>
                    <ul class="ticket__perks">
                        <li>2 heures d'histoires inédites avec Edgar-Yves et Beni Tossou</li>
                        <li>Dimanche 22 novembre, 13h00 précises</li>
                    </ul>
                    {% if soldout %}
                        <button type="button" class="btn btn--primary btn--lg btn--block" data-open-modal="live-tickets">Accès au direct, le même jour</button>
                    {% else %}
                        <a href="#reservation" class="btn btn--primary btn--lg btn--block">Je réserve ma place</a>
                    {% endif %}
                </div>
            </div>
        </section>

        {# ---------- Réservation ---------- #}
        <section id="reservation" class="container section">
            <div class="split booking">
                <div>
                    <p class="eyebrow">Réservation</p>
                    {% if soldout %}
                        <h2 class="booking__title">Salle complète</h2>
                        <p class="booking__note">Toutes les places en salle sont vendues. Le même jour, suivez l'événement en direct, depuis chez vous.</p>
                    {% else %}
                        <h2 class="booking__title">Réservez en 2&nbsp;minutes</h2>
                        <ol class="steps">
                            <li>Choisissez votre billet.</li>
                            <li>Payez en ligne.</li>
                            <li>Recevez votre billet par e-mail et montrez-le à l'entrée.</li>
                        </ol>
                        <p class="booking__note">La salle se remplit. Ne soyez pas celui qui l'a vu sur les réseaux après tout le monde.</p>
                    {% endif %}
                    <div data-controller="countdown" data-countdown-target-value="{{ debut_iso }}">
                        <p class="booking__countdown" data-countdown-target="running" {{ decompte.ended ? 'hidden' }}>
                            Projection dans
                            <span class="booking__countdown-value"><span data-countdown-target="days">{{ decompte.d }}</span>&nbsp;j <span data-countdown-target="hours">{{ decompte.h }}</span>&nbsp;h <span data-countdown-target="minutes">{{ decompte.m }}</span>&nbsp;min <span data-countdown-target="seconds">{{ decompte.s }}</span>&nbsp;s</span>
                        </p>
                    </div>
                </div>

                {# Billetterie tick.africa : la couleur primaire reprend l'accent du site (#F5B82E) #}
                <div class="booking__embed{{ soldout ? ' is-soldout' }}" data-controller="tickafrica">
                    {# Complet : le formulaire reste visible, flouté et inactif, sous le filtre « Sold out » #}
                    <div class="booking__frame"{% if soldout %} inert aria-hidden="true"{% endif %}>
                        <iframe
                            src="https://tick.africa/embed/podlab-au-cinema?primary=F5B82E"
                            title="Billetterie Podlab au Cinéma"
                            class="booking__iframe"
                            height="120"
                            loading="lazy"
                            data-tickafrica-target="frame"
                        ></iframe>
                    </div>

                    {% if soldout %}
                        <div class="soldout" role="region" aria-label="Billetterie en salle complète">
                            <p class="soldout__badge">Sold out</p>
                            <p class="soldout__text">Toutes les places en salle sont vendues.</p>
                            <button type="button" class="btn btn--primary" data-open-modal="live-tickets">Acheter un accès au direct</button>
                            <p class="soldout__sub">Le même jour, en ligne, depuis chez vous.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        {# ---------- Partenaires ---------- #}
        <section class="container section">
            <div class="partners">
                <div class="partner partner--organizers card">
                    <p class="eyebrow">Une co-organisation</p>
                    <div class="partner__logos">
                        <img src="{{ asset('images/logo-podlab.jpg') }}" alt="Podlab" class="partner__podlab" loading="lazy">
                        <span class="partner__times" aria-hidden="true">×</span>
                        <img src="{{ asset('images/logo-benin-bouge.png') }}" alt="Bénin Bouge" class="partner__bb" loading="lazy">
                    </div>
                </div>
                <div class="partner card">
                    <p class="eyebrow">Sponsors officiels</p>
                    <div class="partner__logos partner__logos--sponsors">
                        <img src="{{ asset('images/logo-majestic-benin.webp') }}" alt="Majestic Bénin" class="partner__sponsor" loading="lazy">
                        {# Logo sur fond clair : posé dans une pastille blanche pour rester lisible sur le fond sombre #}
                        <a href="https://tick.africa" target="_blank" rel="noopener" class="partner__chip" aria-label="Tick Africa, billetterie officielle (nouvel onglet)">
                            <img src="{{ asset('images/logo-tickafrica.png') }}" alt="Tick Africa" class="partner__tick" loading="lazy">
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {# Barre d'action collante (mobile) : visible une fois le hero passé, masquée près de la billetterie #}
    <div class="sticky-cta" data-controller="sticky-cta" data-sticky-cta-watch-value='[".hero__cta", "#reservation"]'>
        {% if soldout %}
            <button type="button" class="btn btn--primary" data-open-modal="live-tickets">Sold out · Suivre le direct</button>
        {% else %}
            <a href="#reservation" class="btn btn--primary">Réserver · {{ prix }}&nbsp;FCFA</a>
        {% endif %}
    </div>

    {# ---------- Pop-up : annonce du Sold out + principe du direct (3 validations) + achat ----------
         S'ouvre toute seule à l'arrivée sur la page (une fois par visite) quand la salle est complète,
         et à chaque clic sur un bouton data-open-modal="live-tickets".
         Parcours : annonce → 1. principe → 2. règles → 3. engagement → achat (formulaire Tickafrica). #}
    <dialog
        class="modal"
        data-controller="modal steps"
        data-modal-id-value="live-tickets"
        data-modal-auto-open-value="{{ soldout ? 'true' : 'false' }}"
        data-modal-once-key-value="soldout-announcement"
        data-steps-storage-key-value="live-purchase-steps"
        data-action="click->modal#backdrop close->modal#closed close->steps#reset change->steps#sync"
        aria-labelledby="live-tickets-title"
    >
        <div class="modal__box">
            <button type="button" class="modal__close" data-action="modal#close" aria-label="Fermer la fenêtre">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>

            {# ===== Annonce ===== #}
            <section class="step" data-steps-target="panel">
                {% if soldout %}<p class="modal__badge">Sold out</p>{% endif %}
                <p class="eyebrow">{{ soldout ? 'Salle complète' : 'Accès au direct' }}</p>
                <h2 id="live-tickets-title" class="modal__title" tabindex="-1">{{ soldout ? 'Toutes les places en salle sont vendues' : 'Suivez l\'événement en direct' }}</h2>
                <p class="modal__text">
                    {% if soldout %}
                        Mais vous pouvez vivre « Moi, à quatre pattes&nbsp;?! » en direct, depuis chez vous&nbsp;: <strong>l'accès au direct est en vente</strong>, le dimanche 22 novembre 2026, <strong>aux mêmes heures que la projection (13h00 – 15h00, heure du Bénin)</strong>.
                    {% else %}
                        Vivez « Moi, à quatre pattes&nbsp;?! » en direct, depuis chez vous, le dimanche 22 novembre 2026 de 13h00 à 15h00 (heure du Bénin).
                    {% endif %}
                </p>
                <p class="modal__text">Avant d'acheter, prenez une minute pour comprendre comment fonctionne le direct&nbsp;: trois courtes étapes.</p>
                <div class="step__actions">
                    <button type="button" class="btn btn--primary" data-action="steps#start">Acheter un accès au direct</button>
                    <button type="button" class="btn btn--quiet" data-action="modal#close">Plus tard</button>
                </div>
            </section>

            {# ===== Étape 1 : le principe ===== #}
            <section class="step" data-steps-target="panel" hidden>
                <p class="step__count">Étape 1 sur 3 <span class="step__bar" aria-hidden="true"><i class="is-on"></i><i></i><i></i></span></p>
                <h2 class="modal__title" tabindex="-1">Le principe&nbsp;: un direct, à heure fixe</h2>
                <ol class="timeline">
                    <li class="timeline__item">
                        <p class="timeline__when">Avant le direct</p>
                        <p class="timeline__what">Il n'y a rien à voir. Si vous arrivez avant l'heure, un décompte vous attend.</p>
                    </li>
                    <li class="timeline__item timeline__item--live">
                        <p class="timeline__when">Pendant le direct · 13h00 – 15h00</p>
                        <p class="timeline__what">Vous rejoignez le direct <strong>là où nous en sommes</strong>. Ce qui s'est passé avant votre arrivée, vous ne le rattrapez pas.</p>
                    </li>
                    <li class="timeline__item">
                        <p class="timeline__when">Après le direct</p>
                        <p class="timeline__what"><strong>C'est fini.</strong> Il n'y a ni rediffusion ni replay : la page ne donne plus accès à la vidéo.</p>
                    </li>
                </ol>
                <div class="step__actions">
                    <button type="button" class="btn btn--quiet" data-action="steps#back">Retour</button>
                    <button type="button" class="btn btn--primary" data-action="steps#next">Continuer</button>
                </div>
            </section>

            {# ===== Étape 2 : les règles ===== #}
            <section class="step" data-steps-target="panel" hidden>
                <p class="step__count">Étape 2 sur 3 <span class="step__bar" aria-hidden="true"><i class="is-on"></i><i class="is-on"></i><i></i></span></p>
                <h2 class="modal__title" tabindex="-1">Les règles du direct</h2>
                <ul class="bullets step__list">
                    <li><strong>Pas de pause, pas de retour en arrière.</strong> Le lecteur ne propose que le volume et le plein écran.</li>
                    <li><strong>Pas de rediffusion.</strong> Une fois le direct terminé, la vidéo n'est plus accessible.</li>
                    <li><strong>Un code, un appareil à la fois.</strong> Si vous vous connectez ailleurs avec le même code, le premier appareil est déconnecté.</li>
                    <li><strong>Prévoyez une bonne connexion</strong> (Wi-Fi ou 4G). Si elle coupe, vous reprenez le direct là où il en est.</li>
                    <li>Votre code d'accès vous est envoyé avec votre billet. Le jour J, saisissez-le sur la page du direct.</li>
                </ul>
                <div class="step__actions">
                    <button type="button" class="btn btn--quiet" data-action="steps#back">Retour</button>
                    <button type="button" class="btn btn--primary" data-action="steps#next">Continuer</button>
                </div>
            </section>

            {# ===== Étape 3 : avertissement ===== #}
            <section class="step" data-steps-target="panel" hidden>
                <p class="step__count">Étape 3 sur 3 <span class="step__bar" aria-hidden="true"><i class="is-on"></i><i class="is-on"></i><i class="is-on"></i></span></p>
                <h2 class="modal__title" tabindex="-1">Avertissement&nbsp;: ce direct est protégé</h2>
                <div class="step__warning" role="note">
                    <p><strong>Toute capture d'écran, tout enregistrement, toute copie ou diffusion du direct est strictement interdit</strong>, en tout ou en partie, y compris sur les réseaux sociaux ou les messageries.</p>
                    {% if watermark %}<p>Chaque accès est identifié&nbsp;: le numéro de votre billet s'affiche sur la vidéo. Toute fuite peut être retracée jusqu'à votre billet.</p>{% endif %}
                    <p><strong>Toute personne qui enregistre ou diffuse le direct s'expose à des poursuites judiciaires.</strong></p>
                </div>
                <label class="step__check">
                    <input type="checkbox" data-steps-target="check">
                    <span>J'ai compris le principe et les règles du direct (avant, rien&nbsp;; pendant, je rejoins là où ils en sont&nbsp;; après, c'est fini). Je m'engage à ne pas capturer, enregistrer ni diffuser le direct, et je suis conscient(e) des poursuites judiciaires encourues.</span>
                </label>
                <div class="step__actions">
                    <button type="button" class="btn btn--quiet" data-action="steps#back">Retour</button>
                    <button type="button" class="btn btn--primary" data-steps-target="next" data-action="steps#next" disabled>Valider et passer à l'achat</button>
                </div>
            </section>

            {# ===== Achat ===== #}
            <section class="step" data-steps-target="panel" hidden>
                <p class="eyebrow">Paiement · dimanche 22 novembre, 13h00 – 15h00</p>
                <h2 class="modal__title modal__title--compact" tabindex="-1">Achetez votre accès au direct</h2>

                {% if live_ticket_url %}
                    <div class="modal__embed" data-controller="tickafrica">
                        <iframe
                            data-lazy-src="{{ live_ticket_url }}"
                            title="Billetterie des accès au direct"
                            class="modal__iframe"
                            height="120"
                            data-tickafrica-target="frame"
                        ></iframe>
                    </div>
                    <p class="modal__note">Votre code d'accès au direct vous est envoyé avec votre billet. Le jour J, saisissez-le sur <a href="{{ path('app_live') }}">la page du direct</a> : un code ne fonctionne que sur un appareil à la fois.</p>
                {% else %}
                    <p class="modal__soon">La billetterie des accès au direct ouvre très bientôt. Revenez sur cette page ou suivez Podlab et Bénin Bouge pour l'annonce.</p>
                {% endif %}

                <div class="step__actions">
                    <button type="button" class="btn btn--quiet" data-action="steps#back">Relire les règles</button>
                </div>
            </section>
        </div>
    </dialog>

    {# ---------- Footer ---------- #}
    <footer class="container site-footer">
        <div class="site-footer__brand">
            <img src="{{ asset('images/logo-podlab.jpg') }}" alt="Podlab" class="site-footer__podlab" loading="lazy">
            <img src="{{ asset('images/logo-benin-bouge.png') }}" alt="Bénin Bouge" class="site-footer__bb" loading="lazy">
            <span>Une Édition Spéciale Podlab × Bénin Bouge, en partenariat avec Majestic Bénin et Tick Africa, sponsors officiels.</span>
        </div>
        <span>Une question&nbsp;? Écrivez-nous sur WhatsApp au 0166617878 ou à contact@beninbouge.com.
    </footer>
{% endblock %}
