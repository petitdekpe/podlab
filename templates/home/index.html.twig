{% extends 'base.html.twig' %}

{% block title %}Edgar-Yves : Moi, à quatre pattes ?! · Billetterie Podlab au cinéma{% endblock %}

{% block meta %}
    {% set apercu_titre = 'Podlab au cinéma' ~ (dates_a_venir ? ' : ' ~ (a_venir|length > 1 ? 'séances le ' : 'séance le ') ~ dates_a_venir) %}
    {% set apercu_seances = a_venir|map(s => s.jour ~ ' à ' ~ s.heure ~ ' au ' ~ s.salle.name)|join(', ') %}
    {% set apercu_description = "Edgar-Yves : Moi, à quatre pattes ?! Ceci n'est pas un podcast, ceci n'est pas un stand-up, c'est un sit-down." ~ (apercu_seances ? ' ' ~ apercu_seances ~ ', Cotonou.') %}
    <meta name="description" content="{{ apercu_description }}">

    {# Aperçu du lien (WhatsApp, Facebook, LinkedIn, X…) #}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Podlab × Bénin Bouge">
    <meta property="og:title" content="{{ apercu_titre }}">
    <meta property="og:description" content="{{ apercu_description }}">
    <meta property="og:url" content="{{ absolute_url(path('app_home')) }}">
    <meta property="og:image" content="{{ absolute_url(asset('images/og-avant-premiere.png')) }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Podlab × Bénin Bouge">
    <meta name="twitter:card" content="summary_large_image">
{% endblock %}

{# Prix le plus bas parmi les séances en vente (10 000 FCFA tant que Tick Africa n'a rien dit) #}
{% set prix_min = null %}
{% for s in seances|filter(s => s.onSale and s.prixMin is not null) %}
    {% if prix_min is null or s.prixMin < prix_min %}{% set prix_min = s.prixMin %}{% endif %}
{% endfor %}
{% set prix = (prix_min ?? 10000)|number_format(0, ',', ' ') %}
{% set debut_iso = prochaine ? prochaine.startsAt|date('c') : 'now'|date('c') %}

{# Déroulé de la séance à l'affiche #}
{% set programme = [] %}
{% if vedette %}
    {% set ev = vedette.evenement %}
    {% if ev.portes %}{% set programme = programme|merge([{ heure: ev.portes, titre: 'Accueil et installation' }]) %}{% endif %}
    {% if ev.fermeture %}{% set programme = programme|merge([{ heure: ev.fermeture, titre: 'Fermeture des portes', desc: 'Aucune entrée après, même avec un billet.' }]) %}{% endif %}
    {% set programme = programme|merge([{ heure: ev.horaire, titre: ev.titre, desc: "L'Édition Spéciale Podlab × Bénin Bouge sur grand écran.", highlight: true }]) %}
{% endif %}

{% set pour_qui = [
    'Vous voulez passer un après-midi inoubliable, entre amis, en famille ou en couple.',
    "Vous avez envie d'un vrai moment de fou rire.",
    "Vous êtes fan des émissions Podlab ou des spectacles d'Edgar-Yves.",
    "Vous voulez vivre une expérience au-dessus de tout ce que vous avez déjà vécu en podcast.",
] %}

{% set a_entendre = [
    "Pourquoi, pour des parents béninois, « humoriste » n'est pas un métier… et comment son père a changé d'avis le jour où ça a marché.",
    "Le jour où sa maman a décidé de le « protéger ». Il n'était pas prêt.",
    "Pourquoi au Bénin, quelqu'un que vous avez croisé deux fois vous connaît déjà.",
    "Ce que 20 ans en France ne vous apprennent pas sur votre propre pays.",
] %}

{% set icone_fleche %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{% endset %}
{% set icone_lieu %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>{% endset %}

{% block body %}
    {% if direct_en_cours %}
        <a href="{{ path('app_live') }}" class="live-banner" data-turbo="false">
            <span class="live-banner__dot" aria-hidden="true"></span>
            <span>Le direct du {{ direct_en_cours.date }} est en cours. <strong>Rejoindre le direct</strong></span>
            {{ icone_fleche }}
        </a>
    {% endif %}

    {# ---------- En-tête ---------- #}
    <header class="container site-header">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Podlab × Bénin Bouge">
            <img src="{{ asset('images/logo-podlab.jpg') }}" alt="Podlab" class="brand__podlab">
            <span class="brand__times" aria-hidden="true">×</span>
            <img src="{{ asset('images/logo-benin-bouge.png') }}" alt="Bénin Bouge" class="brand__bb">
        </a>
        <nav class="site-nav" aria-label="Navigation principale">
            <a href="#le-spectacle" class="site-nav__link">Le spectacle</a>
            <a href="#invite" class="site-nav__link">L'invité</a>
            <a href="#programme" class="site-nav__link">Programme</a>
            <a href="#lieu" class="site-nav__link">Les salles</a>
            <a href="#reservation" class="btn btn--primary btn--sm">Réserver</a>
        </nav>
    </header>

    <main data-controller="booking">
        {# ---------- Premier écran : l'affiche à gauche, la billetterie à droite ---------- #}
        <section id="reservation" class="container top" data-controller="poster-fit"{% if affiche %} style="--poster-ratio: {{ (affiche.width / affiche.height)|round(4) }}"{% endif %}>
            <div class="top__poster" data-poster-fit-target="poster">
                <div class="poster">
                    {% if affiche %}
                        <img src="{{ path('app_affiche', { v: affiche.version }) }}" alt="Affiche : « Moi, à quatre pattes ?! » avec Edgar-Yves, par Podlab et Bénin Bouge" class="media-cover poster__img" width="{{ affiche.width }}" height="{{ affiche.height }}" fetchpriority="high">
                    {% else %}
                        <img src="{{ asset(constant('App\\Site\\Affiche::ORIGINE')) }}" alt="Affiche : Podlab et Bénin Bouge présentent « Moi, à quatre pattes ? » avec Edgar-Yves Jr. Dimanche 22 novembre 2026, complet. Dimanche 29 novembre 2026 à partir de 13h, au Majestic Marina (Sofitel Cotonou) et au Majestic Cinéma Wologuèdè. Réservation sur podlab.beninbouge.com" class="media-cover poster__img" width="1200" height="1500" fetchpriority="high">
                    {% endif %}
                    {# Même image, floutée : comble le cadre quand la billetterie est plus haute que l'affiche #}
                    <img src="{{ affiche ? path('app_affiche', { v: affiche.version }) : asset(constant('App\\Site\\Affiche::ORIGINE')) }}" alt="" aria-hidden="true" class="media-cover poster__fill">
                </div>
            </div>

            <div class="top__ticketing booking" data-poster-fit-target="ticketing">
                <div class="top__head">
                    <p class="eyebrow">Billetterie</p>
                    <h1 class="top__title">{{ (vedette ? vedette.titre : constant('App\\Entity\\Evenement::TITRE'))|replace({' ?': ' ?', ' !': ' !'}) }}</h1>
                </div>

                {{ include('home/_commande.html.twig') }}
            </div>
        </section>

        {# ---------- Le spectacle (anciennement le haut de page) ---------- #}
        <section id="le-spectacle" class="container section intro">
            <p class="hero__kicker">Édition spéciale Podlab × Bénin Bouge</p>
            <h2 class="hero__tagline intro__tagline">Ceci n'est pas un podcast. Ceci n'est pas un <span class="nowrap">stand-up</span>. Ceci est un <span class="nowrap">sit-down</span>.</h2>
            <p class="hero__intro">Edgar-Yves vit à l'étranger depuis 20 ans et revient au Bénin de temps à autre. Cette année, lors de son séjour, le pays ne l'a pas raté. Pendant deux heures, il raconte avec Beni Tossou des histoires vécues cette année, qu'il n'a jamais racontées nulle part. Enregistré dans les studios Podlab, projeté sur grand écran en partenariat avec Bénin Bouge.</p>

            {# Les séances en un coup d'œil #}
            {% if seances %}
            <ul class="seance-strip" aria-label="Les séances">
                {% for s in seances %}
                    <li class="seance-strip__item card{{ s.soldOut ? ' is-soldout' }}">
                        <p class="label">{{ s.jourCourt }} · {{ s.heure }}</p>
                        <p class="seance-strip__venue">{{ s.salle.name }}</p>
                        {{ include('home/_statut.html.twig', { s: s }) }}
                    </li>
                {% endfor %}
            </ul>

            {% endif %}

            {# Trailer : se lance au clic (aucun démarrage automatique). Si on dépasse la vidéo en cours de lecture,
               le lecteur passe en miniature dans le coin de l'écran #}
            <div class="trailer" data-controller="trailer">
                <div class="trailer__player" data-trailer-target="player">
                    <video
                        class="trailer__video"
                        data-trailer-target="video"
                        data-action="click->trailer#toggleFromMini"
                        src="{{ asset('videos/trailer.mp4') }}"
                        poster="{{ asset('images/trailer-poster.jpg') }}"
                        controls
                        playsinline
                        preload="metadata"
                        aria-label="Bande-annonce : Edgar-Yves, Moi, à quatre pattes ?!"
                    ></video>
                    <button type="button" class="trailer__mini-btn trailer__expand" data-action="trailer#expand" aria-label="Revenir à la vidéo" title="Revenir à la vidéo">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                    </button>
                    <button type="button" class="trailer__mini-btn trailer__close" data-action="trailer#close" aria-label="Fermer la miniature" title="Fermer">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </div>
                <p class="trailer__placeholder" aria-hidden="true">La bande-annonce continue dans le coin de l'écran</p>
            </div>

            {# Décompte jusqu'à la prochaine séance #}
            {% if seances %}
            <div class="countdown" data-controller="countdown" data-countdown-target-value="{{ debut_iso }}">
                <div data-countdown-target="running" {{ decompte.ended ? 'hidden' }}>
                    <p class="countdown__heading">
                        {% if prochaine %}Prochaine séance · {{ prochaine.jourCourt }} · {{ prochaine.heure }}{% else %}Prochaine séance{% endif %}
                    </p>
                    <div class="countdown__grid" role="timer" aria-live="off">
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="days">{{ decompte.d }}</p>
                            <p class="label">Jours</p>
                        </div>
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="hours">{{ decompte.h }}</p>
                            <p class="label">Heures</p>
                        </div>
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="minutes">{{ decompte.m }}</p>
                            <p class="label">Minutes</p>
                        </div>
                        <div class="countdown__unit">
                            <p class="countdown__value" data-countdown-target="seconds">{{ decompte.s }}</p>
                            <p class="label">Secondes</p>
                        </div>
                    </div>
                </div>
                <div data-countdown-target="ended" {{ decompte.ended ? '' : 'hidden' }}>
                    <p class="countdown__ended-title">La séance a commencé.</p>
                    <p class="countdown__ended-text">Merci d'avoir été là. Suivez Podlab pour la prochaine séance.</p>
                </div>
            </div>

            {% endif %}

            <div class="hero__cta">
                {% if en_vente %}
                    <a href="#reservation" class="btn btn--primary btn--lg">
                        Je réserve{{ dates_en_vente|length < 30 ? ' pour le ' ~ dates_en_vente }} · dès {{ prix }}&nbsp;FCFA
                        {{ icone_fleche }}
                    </a>
                    <span class="hero__cta-note">Mobile Money ou carte · billet envoyé par e-mail.</span>
                {% endif %}
                {% for d in directs %}
                    <button type="button" class="btn btn--outline btn--lg" data-open-modal="{{ d.fenetre }}">Le {{ d.date }}, suivre le direct en ligne</button>
                {% endfor %}
            </div>
        </section>

        {# ---------- Le concept ---------- #}
        <section class="container section split concept">
            <div>
                <p class="eyebrow">Le concept</p>
                <h2 class="h2">Un spectacle avant l'heure</h2>
            </div>
            <div class="lead concept__body">
                <p>Podlab, ce sont des conversations avec ceux qui font l'Afrique. Cette fois, avec Bénin Bouge, on a voulu aller plus loin.</p>
                <p>Edgar-Yves n'est pas venu faire un podcast. Il est venu raconter, avec l'humour qu'on lui connaît, ce qu'il a vécu cette année au Bénin&nbsp;: la famille, les parents, les croyances, les codes qu'il croyait connaître et qui l'ont pris de court.</p>
                <p>Résultat&nbsp;: deux heures qui ressemblent plus à un spectacle qu'à une interview. Alors on a décidé de vous le faire vivre comme un spectacle&nbsp;: en salle, sur grand écran, avec le son du cinéma et le rire de toute une salle.</p>
                <ul class="bullets">
                    <li><strong>Inédit.</strong> Des histoires vécues cette année, racontées ici pour la première fois. Ni en podcast, ni sur scène, ni sur les réseaux.</li>
                    <li><strong>En avant-première.</strong> Vous le découvrez avant tout le monde.</li>
                    <li><strong>Une expérience de salle.</strong> Grand écran, son cinéma, et le plaisir de rire ensemble.</li>
                </ul>
                <p class="concept__closing">Vous croyez connaître Edgar-Yves&nbsp;? Vous n'avez pas encore entendu celle-là.</p>
            </div>
        </section>

        {# ---------- Focus invité ---------- #}
        <section id="invite" class="container section">
            <div class="split guest card">
                <div class="guest__media">
                    <img src="{{ asset('images/edgar-yves.jpg') }}" alt="L'humoriste Edgar-Yves, éclat de rire, en noir et blanc" class="media-cover" loading="lazy">
                    <p class="pill pill--accent">Invité d'honneur</p>
                </div>
                <div class="guest__body">
                    <p class="eyebrow">L'invité</p>
                    <h2 class="h2">Edgar-Yves comme vous ne l'avez jamais entendu</h2>
                    <p class="lead">Né au Bénin en 1987, Edgar-Yves a lâché le droit pour l'humour. Formé dans les comedy clubs de Nantes, passé par le Jamel Comedy Club et La Cigale, il tourne aujourd'hui jusqu'à l'Adidas Arena. Son terrain de jeu&nbsp;: l'autodérision et le choc entre l'Afrique et l'Europe.</p>
                    <blockquote class="guest__quote">« Si la presse est le quatrième pouvoir, l'humour doit être le cinquième. »</blockquote>
                    <div>
                        <p class="guest__listen-title">Ce que vous allez entendre</p>
                        <ul class="bullets">
                            {% for item in a_entendre %}
                                <li>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    <p class="guest__more">Et la réponse à la question que tout le monde va se poser&nbsp;: pourquoi «&nbsp;à quatre pattes&nbsp;»&nbsp;?</p>
                    <div>
                        <a href="#reservation" class="btn btn--primary">Je veux voir Edgar-Yves</a>
                    </div>
                </div>
            </div>
        </section>

        {# ---------- Pour qui ---------- #}
        <section class="container section">
            <p class="eyebrow">Pour qui ?</p>
            <h2 class="h2 u-mb-40">Vous allez adorer si…</h2>
            <div class="audience">
                {% for texte in pour_qui %}
                    <div class="audience__item card">
                        <p class="audience__num">{{ '%02d'|format(loop.index) }}</p>
                        <p>{{ texte }}</p>
                    </div>
                {% endfor %}
            </div>
            <div class="u-mt-32 audience__cta">
                <a href="#reservation" class="btn btn--outline">Je veux en être</a>
            </div>
        </section>

        {# ---------- Programme ---------- #}
        {% if programme %}
        <section id="programme" class="container section">
            <p class="eyebrow">Programme</p>
            <h2 class="h2 u-mb-40">Le déroulé de la séance</h2>
            <div class="schedule">
                {% for etape in programme %}
                    <div class="schedule__row{{ etape.highlight|default(false) ? ' schedule__row--highlight' }}">
                        <p class="schedule__time">{{ etape.heure }}</p>
                        <div>
                            <p class="schedule__title">{{ etape.titre }}</p>
                            {% if etape.desc is defined %}<p class="schedule__desc">{{ etape.desc }}</p>{% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {% endif %}

        {# ---------- Les salles ---------- #}
        {% if salles %}
        <section id="lieu" class="container section">
            <p class="eyebrow">{{ salles|length > 1 ? 'Les salles' : 'La salle' }}</p>
            <h2 class="h2 u-mb-40">{{ lieux_titre }}</h2>
            <div class="venues">
                {% for nom, salle in salles %}
                    {% set lieu = salle.lieu %}
                    {% set photo = lieu ? lieu_photo(lieu) : '' %}
                    <article class="venue-card">
                        {% if photo %}
                            <div class="venue-card__media">
                                <img src="{{ photo }}" alt="{{ lieu.photoAlt ?: nom }}" class="media-cover" style="object-position: {{ lieu.cadrageX }}% {{ lieu.cadrageY }}%" loading="lazy">
                            </div>
                        {% endif %}
                        <div class="venue-card__info">
                            <h3 class="venue-card__name">{{ nom }}</h3>
                            {% if lieu.detail %}<p class="venue-card__sub">{{ lieu.detail }}</p>{% endif %}
                            {% if lieu.adresse %}<p class="venue__address">{{ icone_lieu }} {{ lieu.adresse }}</p>{% endif %}
                            <ul class="venue-card__dates">
                                {% for s in salle.seances %}
                                    <li>{{ s.jour }} · {{ s.heure }}{% if s.soldOut %} <span class="soldout-tag soldout-tag--ink">Sold out</span>{% endif %}</li>
                                {% endfor %}
                            </ul>
                            <a href="https://www.google.com/maps/search/?api=1&amp;query={{ lieu.recherche|url_encode }}" target="_blank" rel="noopener" class="btn btn--dark btn--md">Ouvrir dans Google Maps</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
            {% if lieux_phrase %}<p class="venues__lead">{{ lieux_phrase }}</p>{% endif %}
        </section>

        {% endif %}

        {# ---------- Partenaires ---------- #}
        <section class="container section">
            <div class="partners">
                <div class="partner partner--organizers card">
                    <p class="eyebrow">Une co-organisation</p>
                    <div class="partner__logos">
                        <img src="{{ asset('images/logo-podlab.jpg') }}" alt="Podlab" class="partner__podlab" loading="lazy">
                        <span class="partner__times" aria-hidden="true">×</span>
                        <img src="{{ asset('images/logo-benin-bouge.png') }}" alt="Bénin Bouge" class="partner__bb" loading="lazy">
                    </div>
                </div>
                <div class="partner card">
                    <p class="eyebrow">Sponsors officiels</p>
                    <div class="partner__logos partner__logos--sponsors">
                        <img src="{{ asset('images/logo-majestic-benin.webp') }}" alt="Majestic Bénin" class="partner__sponsor" loading="lazy">
                        {# Logo sur fond clair : posé dans une pastille blanche pour rester lisible sur le fond sombre #}
                        <a href="https://tick.africa" target="_blank" rel="noopener" class="partner__chip" aria-label="Tick Africa, billetterie officielle (nouvel onglet)">
                            <img src="{{ asset('images/logo-tickafrica.png') }}" alt="Tick Africa" class="partner__tick" loading="lazy">
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {# Barre d'action collante (mobile) : visible une fois la billetterie du haut dépassée #}
    <div class="sticky-cta" data-controller="sticky-cta" data-sticky-cta-watch-value='["#reservation", ".hero__cta"]'>
        {% if en_vente %}
            <a href="#reservation" class="btn btn--primary">Réserver · dès {{ prix }}&nbsp;FCFA</a>
        {% elseif directs %}
            <button type="button" class="btn btn--primary" data-open-modal="{{ directs[0].fenetre }}">Suivre le direct</button>
        {% else %}
            <a href="#reservation" class="btn btn--primary">Voir la billetterie</a>
        {% endif %}
    </div>

    {# ---------- Pop-up de chaque direct : validations puis achat ---------- #}
    {% for d in directs %}
        {{ include('home/_direct.html.twig', { d: d, seance: d.evenement ? (seances[d.evenement.cle] ?? null) : null }) }}
    {% endfor %}

    {# ---------- Footer ---------- #}
    <footer class="container site-footer">
        <div class="site-footer__brand">
            <img src="{{ asset('images/logo-podlab.jpg') }}" alt="Podlab" class="site-footer__podlab" loading="lazy">
            <img src="{{ asset('images/logo-benin-bouge.png') }}" alt="Bénin Bouge" class="site-footer__bb" loading="lazy">
            <span>Une Édition Spéciale Podlab × Bénin Bouge, en partenariat avec Majestic Bénin et Tick Africa, sponsors officiels.</span>
        </div>
        <span>Une question&nbsp;? Écrivez-nous sur WhatsApp au 0166617878 ou à contact@beninbouge.com.</span>
        {% if analytics_id() or pixel_id() %}<button type="button" class="site-footer__cookies" data-cookies>Cookies</button>{% endif %}
    </footer>
{% endblock %}

{% block analytics %}{{ include('_analytics.html.twig') }}{% endblock %}
