{% extends 'base.html.twig' %}

{% macro n(v) %}{{ v is null ? '—' : v|number_format(0, ',', ' ') }}{% endmacro %}
{% macro pct(v) %}{% if v is null %}—{% else %}{% set p = (v * 100)|round(1) %}{{ p|number_format(p == p|round ? 0 : 1, ',', ' ') }} %{% endif %}{% endmacro %}

{# Une jauge : nom, pourcentage, barre, et sur combien il est calculé.
   segments : liste de {c: couleur, v: tickets vendus} #}
{% macro jauge(nom, taux, base, libelle, inconnu, segments) %}
    {% import _self as f %}
    <div class="vt-jauge">
        <p class="vt-jauge__head"><span class="vt-jauge__name">{{ nom }}</span> <span class="vt-jauge__pct">{{ f.pct(taux) }}</span></p>
        <div class="vt-fill" aria-hidden="true">
            {% if taux is not null %}
                {% for s in segments|filter(s => s.v > 0) %}<span class="vt-fill__seg vt-s{{ s.c }}" style="width: {{ (s.v / base * 100)|round(2) }}%"></span>{% endfor %}
            {% endif %}
        </div>
        <p class="vt-jauge__base">{% if base is null %}{{ inconnu }}{% else %}sur {{ f.n(base) }} {{ libelle }}{% endif %}</p>
    </div>
{% endmacro %}

{# Les deux mêmes jauges pour le total et pour chaque séance #}
{% macro jauges(b, segments) %}
    {% import _self as f %}
    <div class="vt-jauges">
        {{ f.jauge('Ventes', b.taux_ventes, b.mis_en_vente, 'tickets mis en vente', 'tickets mis en vente : inconnu', segments) }}
        {{ f.jauge('Remplissage', b.taux_remplissage, b.capacite, 'places au total', 'capacité à saisir dans /admin', segments) }}
    </div>
{% endmacro %}

{% block title %}Bilan des ventes · Podlab × Bénin Bouge{% endblock %}

{% block meta %}
    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="refresh" content="120;url={{ path('app_ventes') }}">
    {{ include('ventes/_apercu.html.twig') }}
{% endblock %}

{% block body %}
    {% import _self as f %}
    {% set g = r.global %}
    {% set seances = r.seances %}
    {% set quand = seances|map(s => s.quand)|reduce((l, q) => q in l ? l : l|merge([q]), []) %}

    <div class="vt-page">
    <header class="adm-top">
        <div class="adm-top__in">
            <span class="adm-brand">
                <img src="{{ asset('images/logo-podlab.jpg') }}" alt="" class="adm-brand__logo">
                <span>Bilan des ventes</span>
            </span>
            <a class="adm-btn adm-btn--small vt-top__refresh" href="{{ path('app_ventes', {actualiser: 1}) }}">Actualiser</a>
            <form method="post" action="{{ path('app_ventes_logout') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('ventes') }}">
                <button type="submit" class="adm-btn adm-btn--ghost adm-btn--small">Fermer</button>
            </form>
        </div>
    </header>

    <main class="adm-main">
        <div class="vt-title">
            <h1 class="adm-h1">{{ quand|length == 1 ? quand|first : 'Bilan des ventes' }}</h1>
            <p class="adm-muted">
                {% if g.jours_restants > 1 %}J-{{ g.jours_restants|round(0, 'ceil') }}{% elseif g.jours_restants > 0 %}Dans moins de 24 h{% else %}{{ seances ? 'Séances passées' : 'Aucune séance suivie' }}{% endif %}
                · mis à jour à {{ r.at|date('H\\hi', 'Africa/Porto-Novo') }}
            </p>
        </div>

        {% set tous = [] %}
        {% for key, s in seances %}{% set tous = tous|merge([{c: couleurs[key], v: s.vendus}]) %}{% endfor %}

        <div class="vt-blocs">
            <section class="adm-card vt-bloc vt-bloc--total">
                <h2 class="vt-bloc__name">Total{{ seances|length > 1 ? ' des ' ~ seances|length ~ ' séances' }}</h2>
                <p class="vt-bloc__big">{{ f.n(g.vendus) }} <span class="vt-bloc__unit">tickets vendus</span></p>
                {{ f.jauges(g, tous) }}
            </section>

            {% for key, s in seances %}
                <section class="adm-card vt-bloc">
                    <h2 class="vt-bloc__name"><span class="vt-dot vt-s{{ couleurs[key] }}" aria-hidden="true"></span>{{ s.salle|replace({'Majestic ': ''}) }}{% if quand|length > 1 %} <span class="vt-bloc__unit">{{ s.quand }}</span>{% endif %}</h2>
                    <p class="vt-bloc__big">{{ f.n(s.vendus) }} <span class="vt-bloc__unit">vendus</span></p>
                    {{ f.jauges(s, [{c: couleurs[key], v: s.vendus}]) }}
                </section>
            {% endfor %}
        </div>

        {% if not r.configure %}
            <p class="adm-alert adm-alert--error" role="alert">Aucune clé API Tick Africa : renseignez-la dans /admin › Paramètres.</p>
        {% else %}
            {% if r.test %}
                <p class="adm-alert adm-alert--error" role="alert">Clé Tick Africa de <strong>test</strong> : ces chiffres ne sont pas ceux des vraies ventes.</p>
            {% endif %}
            {% for s in seances|filter(s => s.erreur) %}
                <p class="adm-alert adm-alert--error" role="alert">{{ s.salle }} : {{ s.erreur }}</p>
            {% endfor %}
            {% if not r.commandes_ok %}
                <p class="adm-alert adm-alert--error" role="alert">{{ r.commandes_erreur ?? 'Commandes indisponibles.' }}</p>
            {% endif %}
        {% endif %}
        {% for s in seances|filter(s => s.capacite and s.mis_en_vente > s.capacite) %}
            <p class="adm-alert adm-alert--error" role="alert">{{ s.salle }} : {{ f.n(s.mis_en_vente) }} tickets mis en vente pour {{ f.n(s.capacite) }} places. Vérifiez la capacité dans /admin ou le stock chez Tick Africa.</p>
        {% endfor %}

        <section class="adm-card" aria-label="Recette et ventes récentes">
            <dl class="vt-infos">
                <div><dt>Recette {{ g.recette_reelle ? '(commandes payées)' : '(estimée)' }}</dt><dd>{{ f.n(g.recette) }}{{ g.recette is null ? '' : ' F' }}</dd></div>
                <div><dt>Vendus ces dernières 24 h</dt><dd>{{ r.commandes_ok ? f.n(g.h24) : '—' }}</dd></div>
            </dl>
        </section>

        <details class="vt-details adm-muted">
            <summary>Comment ces chiffres sont calculés</summary>
            <ul class="vt-notes">
                <li>Ventes = tickets vendus ÷ tickets mis en vente chez Tick Africa.</li>
                <li>Remplissage = tickets vendus ÷ capacité de la salle, saisie dans /admin › Évènements.</li>
                <li>Tickets vendus, d'après :
                    {% for s in seances %}{{ s.salle }}, {{ s.source == 'billetterie' ? 'le stock Tick Africa' : (s.source == 'commandes' ? 'les commandes payées' : 'indisponible') }}{{ not loop.last ? ' ; ' }}{% endfor %}.</li>
                <li>Champs reçus de Tick Africa · billet : {{ r.champs.produit|join(', ') ?: '—' }} · commande : {{ r.champs.commande|join(', ') ?: '—' }}</li>
            </ul>
        </details>
    </main>
    </div>
{% endblock %}
