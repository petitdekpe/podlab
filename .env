# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> live (page /live : direct YouTube protégé par un code par billet) ###
# Évènements et directs se gèrent dans /admin. Les variables LIVE_YOUTUBE_ID,
# LIVE_OPENS_AT, LIVE_ENDS_AT, LIVE_TICKETS_URL, TICKAFRICA_EVENT_ID et
# TICKAFRICA_SEANCE_… ne servent qu'UNE FOIS : la migration Version20261124090100
# les reprend en base. Les modifier ensuite n'a plus d'effet.
LIVE_YOUTUBE_ID=
LIVE_OPENS_AT=2026-11-22T12:30:00+01:00
LIVE_ENDS_AT=2026-11-22T16:00:00+01:00
# Empreinte bcrypt du supercode (ouvre /admin et le direct). À définir dans .env.local
# entre APOSTROPHES, ou avec : php bin/console app:live:supercode
LIVE_SUPERCODE_HASH=
LIVE_TICKETS_URL=https://tick.africa/embed/avant-premiere-edgar-yves-moi-a-quatre-pattes-par-podlab-x-benin-bouge-streaming-session

# API Organisateur Tick Africa : les codes saisis sur /live sont validés auprès d'elle.
# Clé secrète (back-office Tick Africa > « API & intégrations »), portées
# tickets:validate (+ events:read pour app:tickafrica:events). À définir dans .env.local.
# ta_live_… en production ; ta_test_… ne valide que les billets de test.
# Valeur par défaut : la clé saisie dans /admin > Paramètres la remplace (chiffrée avec APP_SECRET).
TICKAFRICA_API_KEY=
TICKAFRICA_API_URL=https://api.tick.africa/api/partner/v1
TICKAFRICA_EVENT_ID=

# Billetterie des séances en salle, vendue sur le site par l'API Organisateur.
# La clé TICKAFRICA_API_KEY doit avoir en plus les portées events:read et
# orders:write (orders:read pour afficher l'état du paiement au retour), et
# l'URL de retour https://<domaine>/billetterie/merci enregistrée sur la clé.
# Valeur : « uuid-evenement », ou « uuid-evenement:uuid-tarif,uuid-tarif » pour
# ne vendre que certains billets d'un événement (deux séances dans un même événement).
# Identifiants : php bin/console app:tickafrica:events puis app:tickafrica:event <uuid>.
TICKAFRICA_SEANCE_MARINA_22=
TICKAFRICA_SEANCE_MARINA_28=
TICKAFRICA_SEANCE_WOLOGUEDE_28=

# Code d'accès de la page /ventes (bilan des ventes).
# Changez-le dans .env.local pour le modifier sans toucher au dépôt.
VENTES_CODE=1003
###< live ###
